+def test_startup_never_overwrites_unknown_or_future_schema(client, database):
+    db = legacy_copy(database, database)
+    try:
+        future = {
+            "$jsonSchema": {
+                "bsonType": "object",
+                "properties": {"schema_version": {"enum": [1, 2]}},
+            }
+        }
+        db.command("collMod", "surveys", validator=future)
