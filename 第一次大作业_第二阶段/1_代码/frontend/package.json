{
  "name": "survey-lab-web",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "pnpm run test:unit && pnpm run test:components",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:components": "vitest run --reporter=default --reporter=junit --outputFile=../artifacts/component-tests.xml"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "~2.4.11",
    "jsdom": "^26.1.0",
    "prettier": "~3.6.2",
    "typescript": "~5.8.0",
    "vite": "^6.4.0",
    "vitest": "~3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
