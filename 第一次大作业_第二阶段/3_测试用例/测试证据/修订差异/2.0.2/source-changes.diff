--- 2.0.1/scripts\rehearse-upgrade.py
+++ 2.0.2/scripts\rehearse-upgrade.py
@@ -0,0 +1,76 @@
+"""将真实本地旧数据复制到一次性测试库，验证升级和恢复，不输出身份内容。"""
+
+import json
+from uuid import uuid4
+from app.config import ROOT, settings
+from app.database import connect, initialize, validator_definitions
+from app.migration import canonical, fingerprint, upgrade, rollback
+from app.services.statistics import aggregate
+
+
+def digest_data(db):
+    return {
+        n: fingerprint(list(db[n].find({}).sort("_id", 1)))
+        for n in validator_definitions()
+    }
+
+
+def statistics(db):
+    results = {}
+    for v in db.survey_versions.find({}):
+        survey = db.surveys.find_one({"_id": v["survey_id"]})
+        if survey:
+            owner = db.users.find_one({"_id": survey["owner_id"]})
+            results[v["_id"]] = aggregate(db, survey["_id"], owner, v["version"])
+    return results
+
+
+if __name__ == "__main__":
+    client = connect()
+    source = client[settings.database]
+    name = "survey_lab_test_rehearsal_" + uuid4().hex
+    target = client[name]
+    journal = ROOT / ".local" / ("rehearsal-" + uuid4().hex + ".json")
+    try:
+        legacy = json.loads(
+            (ROOT / "database/legacy/collection_validators.v1.json").read_text("utf-8")
+        )
+        for c in source.list_collections():
+            n = c["name"]
+            if n not in validator_definitions():
+                continue
+            # 可重复演练：临时副本采用初版约束，真实业务文档原样复制。
+            target.create_collection(n, validator={"$jsonSchema": legacy[n]})
+            docs = list(source[n].find({}))
+            if docs:
+                target[n].insert_many(docs)
+        before = digest_data(target)
+        old_stats = statistics(target)
+        upgrade(target, journal)
+        initialize(target)
+        assert before == digest_data(target)
+        assert old_stats == statistics(target)
+        rollback(target, journal)
+        assert before == digest_data(target)
+        upgrade(target, journal.with_name(journal.stem + "-retry.json"))
+        initialize(target)
+        assert old_stats == statistics(target)
+        report = {
+            "source_database": settings.database,
+            "collections": {
+                n: source[n].count_documents({}) for n in validator_definitions()
+            },
+            "data_hashes_preserved": True,
+            "statistics_preserved": True,
+            "rollback_and_retry_passed": True,
+            "published_versions_verified": len(old_stats),
+            "scope": "真实旧业务数据的临时副本；不是业务版本2迁移验证",
+        }
+        (ROOT / "artifacts/migration-rehearsal.json").write_text(
+            json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8"
+        )
+        print(json.dumps(report, ensure_ascii=False))
+    finally:
+        assert name.startswith("survey_lab_test_rehearsal_")
+        client.drop_database(name)
+        client.close()
