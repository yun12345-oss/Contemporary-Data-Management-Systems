+"""对照1.0.2不可变包导出本轮源码差异，不覆盖旧基线。"""
+
+from difflib import unified_diff
+from pathlib import Path
+from zipfile import ZipFile
+
+ROOT = Path(__file__).resolve().parents[1]
+skip = {"node_modules", "dist", "__pycache__", ".pytest_cache"}
+with ZipFile(ROOT / "artifacts/survey-lab-phase1-editor-fixes.zip") as baseline:
+    names = set(baseline.namelist())
+    files = [ROOT / "README.md"]
+    for folder in ("backend", "frontend", "database", "docs", "scripts"):
+        files.extend(
+            p
+            for p in (ROOT / folder).rglob("*")
+            if p.is_file()
+            and not skip.intersection(p.relative_to(ROOT).parts)
+            and ".egg-info" not in str(p)
+            and p.suffix != ".pyc"
+        )
+    chunks = []
+    for path in sorted(files):
+        name = path.relative_to(ROOT).as_posix()
+        try:
+            before = baseline.read(name).decode("utf-8") if name in names else ""
+            after = path.read_text("utf-8")
+        except UnicodeError:
+            continue
+        if before != after:
+            chunks.extend(
+                unified_diff(
+                    before.splitlines(True),
+                    after.splitlines(True),
+                    fromfile="1.0.2/" + name,
+                    tofile="1.1.0/" + name,
+                )
+            )
+(ROOT / "artifacts/resumable-filling.diff").write_text(
+    "".join(chunks), encoding="utf-8"
+)
+print("Resume revision diff generated; previous packages preserved.")
