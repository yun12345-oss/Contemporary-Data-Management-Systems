+"""打包源码与文档，不包含密钥、本地数据库、依赖或原始任务文件。"""
+
+from pathlib import Path
+from zipfile import ZipFile, ZIP_DEFLATED
+import hashlib
+import json
+import argparse
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser()
+parser.add_argument("--label", default="phase1")
+label = parser.parse_args().label
+if not re.fullmatch(r"[A-Za-z0-9_-]+", label):
+    raise SystemExit("Invalid package label")
+SKIP = {
+    "node_modules",
+    "dist",
+    "__pycache__",
+    ".pytest_cache",
+    ".runtime",
+    ".venv",
+    ".local",
+    ".git",
+}
+files = []
+for folder in ("backend", "frontend", "database", "docs", "scripts"):
+    for p in (ROOT / folder).rglob("*"):
+        if (
+            p.is_file()
+            and not SKIP.intersection(p.relative_to(ROOT).parts)
+            and not p.name.endswith(".pyc")
+            and ".egg-info" not in str(p)
+        ):
+            files.append(p)
+for name in (
+    "README.md",
+    ".gitignore",
+    ".dockerignore",
+    ".env.example",
+    "compose.yaml",
+    "Dockerfile",
+):
+    p = ROOT / name
+    if p.exists():
+        files.append(p)
+manifest = {
+    str(p.relative_to(ROOT)).replace("\\", "/"): hashlib.sha256(
+        p.read_bytes()
+    ).hexdigest()
+    for p in sorted(files)
+}
+artifact = ROOT / "artifacts"
+artifact.mkdir(exist_ok=True)
+manifest_path = artifact / f"{label}-manifest.json"
+if manifest_path.exists() and json.loads(manifest_path.read_text("utf-8")) != manifest:
+    raise SystemExit(
+        "Existing baseline differs. Preserve it and use a new --label for subsequent work."
+    )
+manifest_path.write_text(
+    json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8"
+)
+with ZipFile(artifact / f"survey-lab-{label}.zip", "w", ZIP_DEFLATED) as z:
+    for p in sorted(files):
+        z.write(p, p.relative_to(ROOT))
+    z.write(manifest_path, f"{label}-manifest.json")
+    if (artifact / "test-results.xml").exists():
+        z.write(artifact / "test-results.xml", "artifacts/test-results.xml")
+    for name in (
+        "frontend-tests.txt",
+        "build-log.txt",
+        "migration-rehearsal.json",
+        "review-fixes.diff",
+        "review-fixes-tests.xml",
+        "component-tests.xml",
+        "component-tests.txt",
+        "editor-fixes.diff",
+        "editor-browser-check.json",
+        "resumable-filling.diff",
+        "resume-browser-check.json",
+        "resume-compatibility-check.json",
+        "delivery-tests.xml",
+        "delivery-check.json",
+    ):
+        if (artifact / name).exists():
+            z.write(artifact / name, "artifacts/" + name)
+    for p in (artifact / "screenshots").glob("*"):
+        if p.is_file() and p.suffix.lower() in {".png", ".jpg", ".jpeg"}:
+            z.write(p, p.relative_to(ROOT))
+print(f"Packaged {len(files)} project files. Secrets and database excluded.")
