+"""Assemble 2.0.2 materials; preserve all earlier releases and evidence."""
+from pathlib import Path
+import argparse, difflib, hashlib, json, shutil, os
+from zipfile import ZipFile, ZIP_DEFLATED
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / 'submission' / 'phase2-2.0.2'
+EVIDENCE = ROOT / 'artifacts' / 'phase2-2.0.2'
+SKIP = {'node_modules', 'dist', '__pycache__', '.pytest_cache', '.runtime', '.venv', '.local', '.git'}
+
+def digest(p): return hashlib.sha256(p.read_bytes()).hexdigest()
+def write_json(p, value): p.write_text(json.dumps(value, ensure_ascii=False, indent=2), 'utf-8')
+def assemble():
+    OUT.mkdir(parents=True, exist_ok=True)
+    code = OUT / '1_代码'
+    code.mkdir(exist_ok=True)
+    for folder in ('backend', 'frontend', 'database', 'scripts'):
+        for parent, dirs, names in os.walk(ROOT / folder):
+            dirs[:] = [d for d in dirs if d not in SKIP and not d.endswith('.egg-info')]
+            for name in names:
+                source = Path(parent) / name
+                if source.suffix == '.pyc': continue
+                dest = code / source.relative_to(ROOT)
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copy2(source, dest)
+    for name in ('.env.example', '.gitignore', '.dockerignore', 'Dockerfile', 'compose.yaml'):
+        shutil.copy2(ROOT / name, code / name)
+    shutil.copy2(ROOT / 'docs/phase2/运行说明.md', code / 'README.md')
+    for folder, files in {
+        '2_文档': ['系统说明.md', '数据库设计.md', 'API说明.md', '关键逻辑说明.md'],
+        '3_测试用例': ['测试用例与结果.md'],
+        '4_项目完成报告': ['项目完成报告.md', 'AI使用日志.md'],
+    }.items():
+        target = OUT / folder
+        target.mkdir(exist_ok=True)
+        for name in files: shutil.copy2(ROOT / 'docs/phase2' / name, target / name)
+    old = ROOT / 'submission/phase2-2.0.1'
+    report = OUT / '4_项目完成报告/项目完成报告.md'
+    report.write_text(report.read_text('utf-8').replace('](数据库设计.md)', '](../2_文档/数据库设计.md)').replace('](测试用例与结果.md)', '](../3_测试用例/测试用例与结果.md)'), 'utf-8')
+    system = OUT / '2_文档/系统说明.md'
+    system.write_text(system.read_text('utf-8').replace('](运行说明.md)', '](../1_代码/README.md)'), 'utf-8')
+    design = OUT / '2_文档/数据库设计.md'
+    design.write_text(design.read_text('utf-8').replace('](../../database/', '](../1_代码/database/').replace('](../../artifacts/phase2/', '](../3_测试用例/测试证据/历史2.0.0/'), 'utf-8')
+    shutil.copy2(old / '3_测试用例/第一阶段原始测试步骤.md', OUT / '3_测试用例/第一阶段原始测试步骤.md')
