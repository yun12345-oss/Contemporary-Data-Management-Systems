+  if (!b) throw Error("Missing button " + text);
+  return b;
+}
+function pending() {
+  let resolve!: (value: any) => void;
+  const promise = new Promise<any>((r) => (resolve = r));
+  return { promise, resolve };
+}
+const number = {
