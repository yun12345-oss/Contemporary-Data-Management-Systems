+<script setup lang="ts">
+import { ref, onMounted } from "vue";
+import { api } from "../api";
+import { typeNames } from "../types";
+import QuestionSharing from "../components/QuestionSharing.vue";
+const data = ref<any>({ items: [], total: 0 }),
+  page = ref(1),
+  search = ref(""),
